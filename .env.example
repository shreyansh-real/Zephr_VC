# ─── AI provider chain: Gemini → Groq → OpenRouter ───────────────────────────
# Skip any provider whose key is absent. At least one key is required.

# 1) Gemini (Google)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 2) Groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# 3) OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=poolside/laguna-s-2.1:free

# ─── Committee dashboard ───────────────────────────────────────────────────────
# Shared passcode for the /committee login and all /api/* committee routes
COMMITTEE_PASSCODE=

# ─── Firebase Admin SDK (server-side only) ────────────────────────────────────
# From Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Store literal \n for line breaks (not actual newlines)
FIREBASE_PRIVATE_KEY=

# ─── Firebase Client SDK (optional — enables realtime dashboard updates) ───────
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Gmail SMTP (Direct Nodemailer Email Dispatch) ────────────────────────────
# Use your regular Gmail address + a 16-character Google App Password:
# (Generate at: https://myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ─── Optional: Resend fallback (if not using Gmail) ───────────────────────────
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Sochi Society <onboarding@resend.dev>
