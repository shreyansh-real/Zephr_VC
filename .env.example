# AI provider chain: Gemini -> Groq -> OpenRouter (falls through on error/timeout)
# Skip any provider whose key is absent. At least one key is required.

# 1) Gemini (Google)
# Current free-tier model list: https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# 2) Groq
# Current free-tier model list: https://console.groq.com/docs/models
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=qwen/qwen3.8-27b

# 3) OpenRouter
# Current free model list: https://openrouter.ai/models?q=free
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=poolside/laguna-s-2.1:free

# Committee dashboard passcode (shared secret)
COMMITTEE_PASSCODE=your-secret-passcode

# Firebase Admin SDK (server-side only — from Project Settings -> Service Accounts)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the private key with literal \n for newlines (no real line breaks in this file)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Firebase Client SDK (for realtime dashboard updates — optional)
# From Project Settings -> Your apps -> Web app config
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
