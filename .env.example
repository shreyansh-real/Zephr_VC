# ─── Firebase Client SDK (public, safe to commit) ────────────────────────────
# Get these from Firebase Console → Project Settings → Your Apps → Web App → Config
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"

# ─── Emulator flags (set to "true" only in local dev) ────────────────────────
# When NEXT_PUBLIC_USE_EMULATOR=true, the app connects to the local Firebase Emulator Suite
# instead of production Firebase services.
NEXT_PUBLIC_USE_EMULATOR="false"
