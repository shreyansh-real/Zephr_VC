# ─── AI provider chain: Gemini → Groq → OpenRouter ───────────────────────────
# Skip any provider whose key is absent. At least one key is required.

# 1) Gemini (Google)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 2) Groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# 3) OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=poolside/laguna-s-2.1:free

# ─── Committee dashboard ───────────────────────────────────────────────────────
# Shared passcode for the /committee login and all /api/* committee routes
COMMITTEE_PASSCODE=

# ─── Firebase Admin SDK (server-side only) ────────────────────────────────────
# From Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Store literal \n for line breaks (not actual newlines)
FIREBASE_PRIVATE_KEY=

# ─── Firebase Client SDK (optional — enables realtime dashboard updates) ───────
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Optional: Twilio WhatsApp live send (feature-flagged) ────────────────────
# Set SEND_LIVE_WHATSAPP=true to show the "Send automatically" button.
# Leave unset or set to false to hide it entirely (wa.me path still works).
#
# IMPORTANT: This uses the Twilio WhatsApp *sandbox*.
#   Recipients must first join the sandbox by sending a join message to your
#   Twilio sandbox number. Production use requires the WhatsApp Business API.
#
# Get these from https://console.twilio.com → Messaging → Try it out → WhatsApp
SEND_LIVE_WHATSAPP=false
NEXT_PUBLIC_SEND_LIVE_WHATSAPP=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Format: "whatsapp:+14155238886"  (Twilio sandbox number, or your approved sender)
TWILIO_WHATSAPP_FROM=
